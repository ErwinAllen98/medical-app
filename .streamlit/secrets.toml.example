# Copy to .streamlit/secrets.toml and fill in what you have.
# Every key is optional — each stage also has a manual copy-paste bridge.

GEMINI_API_KEY = ""        # knowledge extraction + adaptive question writing
ANTHROPIC_API_KEY = ""     # Claude, the learning-diagnostic engine
NOTION_TOKEN = ""          # internal integration token
NOTION_DATABASE_ID = ""    # the database that stores mastered knowledge

# AnkiWeb sync — the phone path (hub -> AnkiWeb -> AnkiDroid)
ANKIWEB_USERNAME = ""      # your AnkiWeb e-mail
ANKIWEB_PASSWORD = ""      # only used to log in to AnkiWeb
ANKIWEB_ENDPOINT = ""      # leave empty unless you self-host a sync server

ANKI_CONNECT_URL = "http://127.0.0.1:8765"
ANKI_DECK = "Second Brain::Medical"
ANKI_MODEL = "Second Brain Basic"

GEMINI_MODEL = "gemini-2.5-flash"
CLAUDE_MODEL = "claude-sonnet-4-5"
